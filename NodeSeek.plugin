#!name = NodeSeek
#!desc = NodeSeek 每日自动签到（由 Egern 模块移植）：捕获开关、日志开关、固定鸡腿开关、签到时间均可配置（需 Loon 3.2.1+）
#!author = Nullwhy (Loon port by Minis)
#!homepage = https://github.com/Nullwhy/Egern
#!icon = https://raw.githubusercontent.com/Nullwhy/Egern/main/Icon/Nullwhy.png

[Argument]
enableCapture = switch,false,tag=启用 Cookie 捕获,desc=打开后访问 nodeseek 个人中心页可捕获登录请求头；捕获成功后建议关闭，签到不受影响
enableLog = switch,false,tag=开启日志,desc=开启后脚本输出详细日志，可在 Loon 脚本控制台查看
fixedLegs = switch,false,tag=固定 5 鸡腿,desc=关闭=随机鸡腿（默认），开启=固定 5 鸡腿
checkinTime = input,"0 10 * * *",tag=每日签到时间,desc=5 段 cron 表达式：分 时 日 月 周

[Script]
http-response ^https://www\.nodeseek\.com/api/account/getInfo/ requires-body=1,script-path=https://raw.githubusercontent.com/xiaochengshiguduo/nodeseek-loon/main/NodeSeek.loon.js, tag=NodeSeek Cookie, enable = {enableCapture}, argument=[{enableLog}]

cron {checkinTime} script-path=https://raw.githubusercontent.com/xiaochengshiguduo/nodeseek-loon/main/NodeSeek.loon.js, tag=NodeSeek 签到, enable=true, argument=[{fixedLegs},{enableLog}]

[MITM]
hostname = www.nodeseek.com